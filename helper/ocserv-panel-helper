#!/usr/bin/env python3
"""Narrow root helper for ocserv. It accepts typed operations, never shell commands."""
import ipaddress
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlsplit
from pathlib import Path

CONFIG = Path('/etc/ocserv/ocserv.conf')
PASSWD = Path('/etc/ocserv/ocpasswd')
USER_CONFIG_DIR = Path('/etc/ocserv/config-per-user')
META = Path('/etc/ocserv-panel/users.json')
NETWORK = Path('/var/lib/ocserv-panel/network.json')
VPN_DOMAIN = Path('/etc/ocserv-panel/vpn-domain')
USERNAME_RE = re.compile(r'^[A-Za-z0-9_-]{1,32}$')
MAX_EXPIRY = 10 * 365 * 86400


def run(args, input_text=None, timeout=30):
    return subprocess.run(args, input=input_text, text=True, capture_output=True, timeout=timeout)


def _user_lines():
    try:
        return [line.rstrip('\n') for line in PASSWD.read_text(encoding='utf-8').splitlines() if line and ':' in line]
    except FileNotFoundError:
        return []


def users_list():
    return {line.split(':', 1)[0]: line for line in _user_lines()}


def load_meta():
    try:
        data = json.loads(META.read_text(encoding='utf-8'))
    except FileNotFoundError:
        data = {'users': {}}
    if not isinstance(data, dict) or not isinstance(data.get('users'), dict):
        raise RuntimeError('Customer metadata is invalid; restore /etc/ocserv-panel/users.json from backup.')
    return data


def save_meta(data):
    META.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix='.users.', dir=str(META.parent), text=True)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, META)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def set_password(username, password):
    p = run(['ocpasswd', '-c', str(PASSWD), username], password + '\n' + password + '\n')
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout or 'Could not set VPN password.').strip())
    os.chmod(PASSWD, 0o600)


def remove_password(username):
    p = run(['ocpasswd', '-c', str(PASSWD), '-d', username])
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout or 'Could not remove VPN password.').strip())
    os.chmod(PASSWD, 0o600)


def validate_connection_limit(value):
    if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= 4:
        raise ValueError('The simultaneous device limit must be between 1 and 4.')
    return value


def set_connection_limit(username, value):
    validate_username(username)
    value = validate_connection_limit(value)
    USER_CONFIG_DIR.mkdir(mode=0o750, parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix='.client-limit.', dir=str(USER_CONFIG_DIR), text=True)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(f'max-same-clients = {value}\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temp_name, 0o640)
        os.replace(temp_name, USER_CONFIG_DIR / username)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def lock_password(username, locked):
    flag = '-l' if locked else '-u'
    p = run(['ocpasswd', '-c', str(PASSWD), flag, username])
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout or 'Could not update the customer lock.').strip())
    os.chmod(PASSWD, 0o600)


def disable_entry(username, meta, status):
    entries = users_list()
    if username not in entries:
        raise RuntimeError('Customer password entry is missing.')
    record = meta['users'].setdefault(username, {})
    lock_password(username, True)
    record['status'] = status
    record['updated_at'] = int(time.time())


def enable_entry(username, meta):
    record = meta['users'].get(username, {})
    if record.get('expires_at') and int(record['expires_at']) <= int(time.time()):
        raise ValueError('This account has expired. Extend its expiry before enabling it.')
    if username not in users_list():
        raise RuntimeError('Customer password entry is missing; set a new password before enabling this account.')
    lock_password(username, False)
    record['status'] = 'active'
    record['updated_at'] = int(time.time())


def expire_users(meta=None):
    meta = meta or load_meta()
    now = int(time.time())
    changed = []
    for username, record in list(meta['users'].items()):
        expires = record.get('expires_at')
        if record.get('status', 'active') == 'active' and expires and int(expires) <= now:
            disable_entry(username, meta, 'expired')
            changed.append(username)
    if changed:
        save_meta(meta)
    return changed


def get_settings():
    content = CONFIG.read_text(encoding='utf-8')
    def one(pattern, default=''):
        m = re.search(pattern, content, re.M)
        return m.group(1).strip() if m else default
    cert_setting = one(r'^\s*server-cert\s*=\s*(.*?)\s*$')
    cert_path = cert_setting.strip().strip('"\'')
    path_domain = ''
    cert_parts = Path(cert_path).parts
    if 'live' in cert_parts:
        live_index = cert_parts.index('live')
        if live_index + 1 < len(cert_parts):
            candidate = cert_parts[live_index + 1]
            if re.fullmatch(r'[A-Za-z0-9.-]+', candidate):
                path_domain = candidate
    configured_domain = VPN_DOMAIN.read_text(encoding='utf-8').strip() if VPN_DOMAIN.is_file() else ''
    if not re.fullmatch(r'[A-Za-z0-9.-]+', configured_domain):
        configured_domain = ''
    cert_names = []
    if cert_path and Path(cert_path).is_file():
        cert = run(['openssl', 'x509', '-in', cert_path, '-noout', '-ext', 'subjectAltName'])
        cert_names = sorted(set(re.findall(r'DNS:([A-Za-z0-9.-]+)', cert.stdout))) if cert.returncode == 0 else []
    domain = next((candidate for candidate in (path_domain, configured_domain) if candidate and (not cert_names or candidate in cert_names)), '')
    if not domain and len(cert_names) == 1:
        domain = cert_names[0]
    auth_file = get_auth_passwd_path(content)
    return {
        'domain': domain,
        'port': one(r'^\s*tcp-port\s*=\s*(\d+)\s*$', '443'),
        'dns': re.findall(r'^\s*dns\s*=\s*(\S+)\s*$', content, re.M),
        'auth_passwd': str(auth_file) if auth_file else '',
        'auth_file_exists': bool(auth_file and auth_file.is_file()),
    }


def validate_endpoint_host(value, optional=False):
    if not isinstance(value, str):
        raise ValueError('VPN endpoint must be a hostname or IP address.')
    value = value.strip()
    if not value and optional:
        return ''
    if not value or len(value) > 253 or value.startswith('.') or value.endswith('.'):
        raise ValueError('Enter a valid VPN hostname or IP address.')
    try:
        return str(ipaddress.ip_address(value))
    except ValueError:
        labels = value.split('.')
        if any(not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', label) for label in labels):
            raise ValueError('Enter a valid VPN hostname or IP address.')
        return value.lower()


def validate_endpoint_port(value):
    try:
        port = int(value)
    except (TypeError, ValueError):
        raise ValueError('VPN endpoint port must be between 1 and 65535.')
    if isinstance(value, bool) or not 1 <= port <= 65535:
        raise ValueError('VPN endpoint port must be between 1 and 65535.')
    return port


def validate_subscription_url(value):
    if not isinstance(value, str):
        raise ValueError('Subscription URL must be HTTPS.')
    value = value.strip()
    if not value:
        return ''
    try:
        parsed = urlsplit(value)
        hostname = validate_endpoint_host(parsed.hostname or '')
        port = parsed.port
    except (ValueError, TypeError):
        raise ValueError('Enter an HTTPS subscription base URL, for example https://sub.example.com:8443.')
    if parsed.scheme != 'https' or not hostname or parsed.username or parsed.password or parsed.path not in ('', '/') or parsed.query or parsed.fragment:
        raise ValueError('Subscription base URL must be HTTPS and contain only a hostname and optional port.')
    hostname_url = f'[{hostname}]' if ':' in hostname else hostname
    return f'https://{hostname_url}' + (f':{port}' if port else '')


def network_settings():
    local = get_settings()
    default = {
        'primary_host': local.get('domain', ''),
        'primary_port': int(local.get('port', '443')),
        'backup_host': '',
        'backup_port': int(local.get('port', '443')),
        'active_endpoint': 'primary',
        'subscription_base_url': '',
    }
    try:
        saved = json.loads(NETWORK.read_text(encoding='utf-8'))
    except FileNotFoundError:
        saved = {}
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError('Network settings file is invalid; use the terminal menu to repair it.') from exc
    if not isinstance(saved, dict):
        raise RuntimeError('Network settings file is invalid; use the terminal menu to repair it.')
    for key in default:
        if key in saved:
            default[key] = saved[key]
    default['primary_host'] = validate_endpoint_host(default['primary_host']) if default['primary_host'] else ''
    default['primary_port'] = validate_endpoint_port(default['primary_port'])
    default['backup_host'] = validate_endpoint_host(default['backup_host'], optional=True)
    default['backup_port'] = validate_endpoint_port(default['backup_port'])
    if default['active_endpoint'] not in ('primary', 'backup') or (default['active_endpoint'] == 'backup' and not default['backup_host']):
        default['active_endpoint'] = 'primary'
    default['subscription_base_url'] = validate_subscription_url(default['subscription_base_url'])
    return default


def profile_endpoints():
    config = network_settings()
    candidates = {
        'primary': {'name': 'UserrTM Primary', 'host': config['primary_host'], 'port': config['primary_port']},
        'backup': {'name': 'UserrTM Backup', 'host': config['backup_host'], 'port': config['backup_port']},
    }
    order = [config['active_endpoint'], 'backup' if config['active_endpoint'] == 'primary' else 'primary']
    return [candidates[key] for key in order if candidates[key]['host']]


def save_network_settings(req):
    primary_host = validate_endpoint_host(req.get('primary_host', ''))
    primary_port = validate_endpoint_port(req.get('primary_port', 443))
    backup_host = validate_endpoint_host(req.get('backup_host', ''), optional=True)
    backup_port = validate_endpoint_port(req.get('backup_port', 443))
    active_endpoint = req.get('active_endpoint', 'primary')
    if active_endpoint not in ('primary', 'backup') or (active_endpoint == 'backup' and not backup_host):
        raise ValueError('Choose a configured primary or backup VPN endpoint.')
    subscription_base_url = validate_subscription_url(req.get('subscription_base_url', ''))
    if subscription_base_url:
        subscription_host = urlsplit(subscription_base_url).hostname or ''
        panel_cert = Path('/etc/ocserv-panel/tls/fullchain.pem')
        if panel_cert.is_file():
            check = run(['openssl', 'x509', '-in', str(panel_cert), '-noout', '-checkhost', subscription_host])
            if check.returncode:
                raise ValueError('The panel TLS certificate does not cover this subscription hostname. Set it through sudo any first, after its DNS points to this VPS.')
    payload = {
        'primary_host': primary_host,
        'primary_port': primary_port,
        'backup_host': backup_host,
        'backup_port': backup_port,
        'active_endpoint': active_endpoint,
        'subscription_base_url': subscription_base_url,
    }
    NETWORK.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix='.network.', dir=str(NETWORK.parent), text=True)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(payload, f, ensure_ascii=False, indent=2)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temp_name, 0o640)
        os.replace(temp_name, NETWORK)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass
    return payload


def get_auth_passwd_path(content=None):
    content = content if content is not None else CONFIG.read_text(encoding='utf-8')
    match = re.search(r'^\s*auth\s*=\s*["\']?plain\[passwd=([^\]"\']+)\]["\']?\s*$', content, re.M)
    return Path(match.group(1).strip()) if match else None


def service_status():
    p = run(['systemctl', 'is-active', 'ocserv'])
    active = p.stdout.strip() or 'unknown'
    q = run(['systemctl', 'show', 'ocserv', '--property=ActiveEnterTimestamp', '--value'])
    return {'active': active, 'since': q.stdout.strip()}


def config_check():
    p = run(['ocserv', '-t', '-c', str(CONFIG)])
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout or 'ocserv config check failed').strip())
    passwd_path = get_auth_passwd_path()
    if passwd_path and not passwd_path.is_file():
        raise RuntimeError(f'VPN password file is missing: {passwd_path}. Set auth to /etc/ocserv/ocpasswd and restart ocserv.')
    return 'Configuration is valid.'


def validate_username(username):
    if not isinstance(username, str) or not USERNAME_RE.fullmatch(username):
        raise ValueError('Username must use letters, numbers, underscore or hyphen (1–32 chars).')


def validate_password(password):
    if not isinstance(password, str) or not password or len(password) > 128 or '\n' in password or '\r' in password:
        raise ValueError('Password must be non-empty, at most 128 characters, and cannot contain line breaks.')


def expiry_from_days(days):
    if days is None or days == '':
        return None
    try:
        days = int(days)
    except (TypeError, ValueError):
        raise ValueError('Expiry must be a number of days or unlimited.')
    if not 1 <= days <= 3650:
        raise ValueError('Expiry must be between 1 and 3650 days.')
    return int(time.time()) + days * 86400


def expiry_from_request(req):
    """Return expiry from unlimited, days, or an explicit Unix timestamp."""
    if 'expires_at' in req:
        value = req.get('expires_at')
        if value is None or value == '':
            return None
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValueError('Expiry timestamp must be an integer or null.')
        now = int(time.time())
        if not now < value <= now + MAX_EXPIRY:
            raise ValueError('Expiry date must be in the future and within 10 years.')
        return value
    return expiry_from_days(req.get('days'))


def snapshot(meta):
    active_entries = users_list()
    users = []
    changed = False
    names = set(active_entries) | set(meta['users'])
    for username in sorted(names, key=str.casefold):
        if username not in meta['users']:
            meta['users'][username] = {'status': 'active' if username in active_entries else 'disabled', 'created_at': int(time.time())}
            changed = True
        record = meta['users'][username]
        status = record.get('status', 'active' if username in active_entries else 'disabled')
        if status not in ('active', 'disabled', 'expired'):
            status = 'active' if username in active_entries else 'disabled'
            record['status'] = status
            changed = True
        if not isinstance(record.get('profile_token'), str) or not re.fullmatch(r'[A-Za-z0-9_-]{40,}', record['profile_token']):
            record['profile_token'] = secrets.token_urlsafe(32)
            changed = True
        users.append({
            'username': username,
            'status': status,
            'expires_at': record.get('expires_at'),
            'created_at': record.get('created_at'),
            'profile_token': record['profile_token'],
            'max_same_clients': record.setdefault('max_same_clients', 1),
        })
    if changed:
        save_meta(meta)
    return users


def customer_profile(token):
    if not isinstance(token, str) or not re.fullmatch(r'[A-Za-z0-9_-]{40,}', token):
        raise ValueError('Profile not found.')
    meta = load_meta()
    matches = []
    for username, record in meta['users'].items():
        saved = record.get('profile_token', '')
        if isinstance(saved, str) and secrets.compare_digest(saved, token):
            matches.append((username, record))
    if len(matches) != 1:
        raise ValueError('Profile not found.')
    username, record = matches[0]
    expires = record.get('expires_at')
    if (record.get('status', 'active') != 'active' or username not in users_list()
            or (expires and int(expires) <= int(time.time()))):
        raise ValueError('Profile is inactive or expired.')
    endpoints = profile_endpoints()
    if not endpoints:
        raise RuntimeError('No active VPN endpoint is configured.')
    return {'username': username, 'endpoints': endpoints, 'network': network_settings()}


def action(req):
    op = req.get('op')
    if op == 'state':
        meta = load_meta()
        expire_users(meta)
        meta = load_meta()
        return {
            'users': snapshot(meta),
            'settings': {**get_settings(), **network_settings(), 'endpoints': profile_endpoints()},
            'service': service_status(),
            'logs': run(['journalctl', '-u', 'ocserv', '-n', '40', '--no-pager', '-o', 'cat']).stdout,
        }
    if op == 'profile':
        endpoints = profile_endpoints()
        if not endpoints:
            raise RuntimeError('No active VPN endpoint is configured.')
        return {'endpoints': endpoints, 'network': network_settings()}
    if op == 'customer_profile':
        return customer_profile(req.get('token'))
    if op == 'save_network':
        return {'message': 'VPN profile endpoints saved.', 'settings': save_network_settings(req)}
    if op == 'add_user':
        username, password = req.get('username', ''), req.get('password', '')
        validate_username(username)
        validate_password(password)
        max_same_clients = validate_connection_limit(req.get('max_same_clients', 1))
        meta = load_meta()
        if username in users_list() or username in meta['users']:
            raise ValueError('Customer already exists. Use password reset or re-enable instead.')
        expires_at = expiry_from_request(req)
        set_password(username, password)
        profile_token = secrets.token_urlsafe(32)
        try:
            set_connection_limit(username, max_same_clients)
            meta['users'][username] = {
                'status': 'active',
                'expires_at': expires_at,
                'created_at': int(time.time()),
                'profile_token': profile_token,
                'max_same_clients': max_same_clients,
            }
            save_meta(meta)
        except Exception:
            remove_password(username)
            (USER_CONFIG_DIR / username).unlink(missing_ok=True)
            raise
        return {'message': 'Customer added.', 'profile_token': profile_token}
    if op == 'delete_user':
        username = req.get('username', '')
        validate_username(username)
        meta = load_meta()
        if username in users_list():
            remove_password(username)
        elif username not in meta['users']:
            raise ValueError('Customer not found.')
        meta['users'].pop(username, None)
        (USER_CONFIG_DIR / username).unlink(missing_ok=True)
        save_meta(meta)
        return {'message': 'Customer permanently removed.'}
    if op == 'set_limit':
        username = req.get('username', '')
        validate_username(username)
        if username not in users_list():
            raise ValueError('Customer not found.')
        value = validate_connection_limit(req.get('max_same_clients'))
        meta = load_meta()
        record = meta['users'].setdefault(username, {'status': 'active', 'created_at': int(time.time())})
        set_connection_limit(username, value)
        record['max_same_clients'] = value
        record['updated_at'] = int(time.time())
        save_meta(meta)
        return {'message': 'Simultaneous device limit updated.', 'max_same_clients': value}
    if op in ('disable_user', 'enable_user', 'set_expiry', 'reset_password'):
        username = req.get('username', '')
        validate_username(username)
        meta = load_meta()
        record = meta['users'].setdefault(username, {'status': 'active', 'created_at': int(time.time())})
        exists = username in users_list()
        if not exists:
            raise ValueError('Customer not found.')
        if op == 'disable_user':
            if record.get('status', 'active') != 'active':
                raise ValueError('Customer is already disabled.')
            disable_entry(username, meta, 'disabled')
        elif op == 'enable_user':
            if record.get('status', 'active') == 'active':
                raise ValueError('Customer is already active.')
            enable_entry(username, meta)
        elif op == 'set_expiry':
            previous = record.get('status', 'active')
            record['expires_at'] = expiry_from_request(req)
            if previous == 'expired' and (record['expires_at'] is None or record['expires_at'] > int(time.time())):
                enable_entry(username, meta)
        else:
            password = req.get('password', '')
            validate_password(password)
            was_disabled = record.get('status', 'active') != 'active'
            if was_disabled:
                lock_password(username, False)
            try:
                set_password(username, password)
            finally:
                if was_disabled:
                    lock_password(username, True)
        record['updated_at'] = int(time.time())
        save_meta(meta)
        return {'message': 'Customer updated.'}
    if op == 'expire':
        return {'expired': expire_users()}
    if op == 'save_dns':
        dns_values = req.get('dns', [])
        if not isinstance(dns_values, list) or not 1 <= len(dns_values) <= 4:
            raise ValueError('Enter between one and four DNS server IPs.')
        if any(not isinstance(x, str) for x in dns_values):
            raise ValueError('DNS entries must be valid IPv4 or IPv6 addresses.')
        try:
            dns_values = [str(ipaddress.ip_address(x.strip())) for x in dns_values]
        except ValueError:
            raise ValueError('DNS entries must be valid IPv4 or IPv6 addresses.')
        if not dns_values:
            raise ValueError('At least one DNS server is required.')
        lines = CONFIG.read_text(encoding='utf-8').splitlines(keepends=True)
        backup = str(CONFIG) + '.backup.' + time.strftime('%Y%m%d%H%M%S')
        shutil.copy2(CONFIG, backup)
        lines = [line for line in lines if not re.match(r'^\s*dns\s*=', line)]
        insert_at = next((i for i, line in enumerate(lines) if re.match(r'^\s*route\s*=', line)), len(lines))
        lines[insert_at:insert_at] = [f'dns = {ip}\n' for ip in dns_values]
        CONFIG.write_text(''.join(lines), encoding='utf-8')
        try:
            config_check()
            p = run(['systemctl', 'restart', 'ocserv'])
            if p.returncode:
                raise RuntimeError((p.stderr or p.stdout or 'ocserv restart failed').strip())
        except Exception:
            shutil.copy2(backup, CONFIG)
            run(['systemctl', 'restart', 'ocserv'])
            raise
        return {'message': 'DNS settings saved and ocserv restarted.'}
    if op == 'restart':
        config_check()
        p = run(['systemctl', 'restart', 'ocserv'])
        if p.returncode:
            raise RuntimeError((p.stderr or p.stdout or 'ocserv restart failed').strip())
        return {'message': 'ocserv restarted.'}
    if op == 'check':
        return {'message': config_check()}
    raise ValueError('Unsupported operation.')


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Helper must run as root.')
    if sys.argv[1:] == ['--expire']:
        print(json.dumps({'ok': True, 'data': {'expired': expire_users()}}))
        return
    if sys.argv[1:]:
        raise ValueError('Unsupported helper argument.')
    req = json.load(sys.stdin)
    if not isinstance(req, dict):
        raise ValueError('Request must be a JSON object.')
    result = action(req)
    print(json.dumps({'ok': True, 'data': result}))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(json.dumps({'ok': False, 'error': str(exc)}))
        sys.exit(1)
